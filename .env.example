# Secrets and host-specific settings only.
# Pipeline tunables live in include/config/pipeline.yml.
#
# Use `make init` — it generates the secrets below. A plain cp leaves the
# REPLACE_ME placeholders in place.

# Non-standard on purpose: this machine already runs MySQL on 3306 and
# PostgreSQL on 5432.
AIRFLOW_UI_PORT=8080
MYSQL_HOST_PORT=3307
POSTGRES_HOST_PORT=5433

MYSQL_DATABASE=flight_staging
MYSQL_USER=flight
MYSQL_PASSWORD=REPLACE_ME_openssl_rand_hex_16
MYSQL_ROOT_PASSWORD=REPLACE_ME_openssl_rand_hex_16

POSTGRES_DB=flight_analytics
POSTGRES_USER=flight
POSTGRES_PASSWORD=REPLACE_ME_openssl_rand_hex_16

# Must match your uid or the containers write root-owned files into ./logs.
AIRFLOW_UID=1000

# Referenced by docker-compose.yaml WITHOUT defaults: leaving them unset starts
# Airflow with an empty Fernet key and JWT secret.
#   FERNET_KEY: openssl rand -base64 32 | tr '+/' '-_'
#   JWT secret: openssl rand -hex 32
FERNET_KEY=REPLACE_ME_openssl_rand_base64_32_urlsafe=
AIRFLOW__API_AUTH__JWT_SECRET=REPLACE_ME_openssl_rand_hex_32

AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
