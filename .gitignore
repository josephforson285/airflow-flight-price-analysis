# ---- data ----
# The directory name says whether a file is tracked:
#   raw/        bulk source extracts       -- ignored
#   reference/  curated lookup data        -- tracked, read by every run
#   fixtures/   deliberately broken input  -- tracked, test material
#
# Order and the '**' form are load-bearing: excluding the DIRECTORY makes git
# skip it entirely, so no later '!' rule inside it can take effect.
*.parquet
*.xlsx
*.csv
include/data/**
!include/data/reference/
!include/data/reference/**
!include/data/fixtures/
!include/data/fixtures/**

# ---- secrets ----
.env
.env.*
!.env.example
*.pem
*.key
kaggle.json

# ---- airflow runtime ----
logs/
airflow.db
airflow.cfg
airflow-webserver.pid
standalone_admin_password.txt
config/airflow.cfg

# ---- python ----
*.egg-info/
build/
dist/
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- editor / os ----
.vscode/
.idea/
.DS_Store
*.swp
