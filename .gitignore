# ---- data ----
# Three kinds of thing live under include/data/, and the directory name is
# what tells you which is which:
#   raw/        bulk source extracts        -> never committed
#   reference/  small curated lookup data   -> committed, read by every run
#   fixtures/   deliberately broken input   -> committed, test material only
#
# NOTE ordering + the '**' form are both load-bearing. Excluding the
# DIRECTORY (`include/data/`) makes git skip it entirely, so no later
# '!' rule inside it can ever take effect. We exclude the CONTENTS
# instead, then re-admit the tracked subdirectories, in that order.
*.parquet
*.xlsx
*.csv
include/data/**
!include/data/reference/
!include/data/reference/**
!include/data/fixtures/
!include/data/fixtures/**

# ---- secrets ----
.env
.env.*
!.env.example
*.pem
*.key
kaggle.json

# ---- airflow runtime ----
logs/
airflow.db
airflow.cfg
airflow-webserver.pid
standalone_admin_password.txt
config/airflow.cfg

# ---- python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- editor / os ----
.vscode/
.idea/
.DS_Store
*.swp
